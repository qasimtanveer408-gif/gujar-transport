# Replace the domain and certificate paths with your issued HTTPS certificate.
server {
    listen 80;
    server_name transport.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name transport.example.com;
    ssl_certificate /etc/letsencrypt/live/transport.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/transport.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/xml image/svg+xml;
    client_max_body_size 11m;
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
