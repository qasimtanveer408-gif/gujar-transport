# Copy to .env on the production server; replace every example value.
APP_ENV=production
NODE_ENV=production
PORT=5000
APP_URL=https://transport.example.com
ALLOWED_ORIGINS=https://transport.example.com
BUSINESS_TIMEZONE=Asia/Karachi
CURRENCY=PKR
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-project-publishable-key
SUPABASE_SECRET_KEY=replace-with-your-project-server-secret-key
# Generate a 64-character hexadecimal key using npm run secrets:generate.
SESSION_ENCRYPTION_KEY=replace-with-a-generated-64-character-hex-key
ADMIN_BOOTSTRAP_ENABLED=false
ALLOW_LIVE_DATABASE_ACCESS=true
LOG_LEVEL=info
# Use 1 only when a single trusted reverse proxy fronts this application.
TRUST_PROXY_HOPS=1
